<% content_for :title, "Admin sign in" %>
<% content_for :body_class, "auth-page" %>

<div class="auth-card">
  <div class="auth-mark" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <rect x="4" y="10" width="16" height="11" rx="3"></rect>
      <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
      <path d="M12 15v2"></path>
    </svg>
  </div>

  <div class="auth-heading">
    <% if @setting.admin_password_configured? %>
      <h1>Welcome back</h1>
      <p>Sign in to look after your OpenClaw gateway.</p>
    <% else %>
      <h1>Create admin password</h1>
      <p>Protect the panel with an admin password before anything else.</p>
    <% end %>
  </div>

  <% if @setting.errors.any? %>
    <div class="errors">
      <ul>
        <% @setting.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with url: admin_login_path, class: "stack" do |form| %>
    <div class="auth-field">
      <%= form.label :password, "Password" %>
      <div class="password-input">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect x="4" y="10" width="16" height="11" rx="3"></rect>
          <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
        </svg>
        <%= form.password_field :password, required: true, minlength: 12, autofocus: true,
              autocomplete: @setting.admin_password_configured? ? "current-password" : "new-password",
              placeholder: @setting.admin_password_configured? ? "Enter your admin password" : "At least 12 characters" %>
      </div>
    </div>

    <% unless @setting.admin_password_configured? %>
      <div class="auth-field">
        <%= form.label :password_confirmation, "Confirm password" %>
        <div class="password-input">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="4" y="10" width="16" height="11" rx="3"></rect>
            <path d="M8 10V7a4 4 0 0 1 8 0v3"></path>
          </svg>
          <%= form.password_field :password_confirmation, required: true, minlength: 12,
                autocomplete: "new-password", placeholder: "Repeat your password" %>
        </div>
      </div>
    <% end %>

    <div class="auth-actions">
      <%= form.submit @setting.admin_password_configured? ? "Sign in" : "Create password" %>
    </div>
  <% end %>
</div>
